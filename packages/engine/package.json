{
  "name": "@onstreak/engine",
  "version": "0.1.0",
  "description": "onstreak gamification engine and HTTP server",
  "license": "MIT",
  "author": "Koustav Dey",
  "homepage": "https://github.com/imnottaken/onstreak#readme",
  "bugs": {
    "url": "https://github.com/imnottaken/onstreak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imnottaken/onstreak.git",
    "directory": "packages/engine"
  },
  "keywords": [
    "gamification",
    "streaks",
    "leaderboard",
    "achievements",
    "xp",
    "leagues",
    "points",
    "engagement",
    "postgres",
    "self-hosted"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "onstreak": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.0"
  }
}
